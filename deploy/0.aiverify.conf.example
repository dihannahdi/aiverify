# Generated by aiverify. Logs only requests whose user-agent claims a known crawler.
SetEnvIfNoCase User-Agent "(oai-searchbot|chatgpt-user|gptbot|perplexity-user|perplexitybot|claude-searchbot|claude-user|claudebot|meta-externalagent|bytespider|amazonbot|ccbot|googlebot|bingbot|applebot)" aiv_claim
GlobalLog "/www/wwwlogs/aiverify-claims.log" "%{sec}t %v %a \"%{CF-Connecting-IP}i\" \"%r\" %>s %B \"%{Referer}i\" \"%{User-Agent}i\"" env=aiv_claim
